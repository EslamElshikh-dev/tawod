{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/construction-building-riyadh/index.html",
      "destination": "/blog/construction-building-riyadh/",
      "permanent": true
    },
    {
      "source": "/blog/mechanical-mep-works-riyadh/index.html",
      "destination": "/blog/mechanical-mep-works-riyadh/",
      "permanent": true
    },
    {
      "source": "/blog/best-contracting-company-riyadh/index.html",
      "destination": "/blog/best-contracting-company-riyadh/",
      "permanent": true
    },
    {
      "source": "/blog/bone-construction-riyadh-guide/index.html",
      "destination": "/blog/bone-construction-riyadh-guide/",
      "permanent": true
    },
    {
      "source": "/blog/turnkey-commercial-fitout-riyadh/index.html",
      "destination": "/blog/turnkey-commercial-fitout-riyadh/",
      "permanent": true
    },
    {
      "source": "/blog/finishing-facades-restoration-riyadh/index.html",
      "destination": "/blog/finishing-facades-restoration-riyadh/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/lp/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
